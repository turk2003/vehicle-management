  "cards": [
    {
      "dot": "cyan",
      "title": "ชนิดข้อมูลและคีย์",
      "items": [
        "แสดงคอลัมน์จริงครบทุกฟิลด์; TEXT id ใช้ uuid() ฝั่ง Prisma ไม่ใช่ชนิด UUID ของ PostgreSQL",
        "NULL หมายถึงฟิลด์ไม่บังคับ; PK = คีย์หลัก, FK = คีย์นอก, UK = unique",
        "RolePermission: role และ permission เป็น unique ร่วมกัน ไม่ได้ unique แยกคอลัมน์"
      ]
    },
    {
      "dot": "cyan",
      "title": "ความสัมพันธ์",
      "items": [
        "Booking.userId คือผู้ขอ; approverId คือผู้ตัดสินซึ่งยังไม่มีได้ก่อนอนุมัติ",
        "Notification เชื่อม Booking หรือ Maintenance แบบไม่บังคับ; มี userId เป็นเจ้าของ",
        "RolePermission เก็บ UserRole เป็น enum ไม่มี FK เชื่อม User"
      ]
    },
    {
      "dot": "cyan",
      "title": "สถานะและดัชนี",
      "items": [
        "Booking: PENDING / APPROVED / REJECTED / CANCELLED / CHANGED / IN_PROGRESS / COMPLETED",
        "Vehicle: AVAILABLE / BOOKED / IN_USE / MAINTENANCE; Maintenance: REPORTED / IN_PROGRESS / COMPLETED",
        "Booking มี index(vehicleId,startDate,endDate); User.email และ Vehicle.plateNumber เป็น unique"
      ]
    }
  ],
